{
  "name": "carelineconnect-monorepo",
  "private": true,
  "scripts": {
    "dev": "node api.js && bun run --filter '*' dev",
    "build": "node api.js && bun run --filter '*' build",
    "db:generate": "bun run --filter '@repo/db' generate",
    "db:push": "bun run --filter '@repo/db' push",
    "db:studio": "bun run --filter '@repo/db' studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.5",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.12.0"
  }
}
